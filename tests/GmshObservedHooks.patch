+extern "C" MESHSTUDIO_REFERENCE_EXPORT int meshstudioReferenceFaceUses(
+  int faceTag, double *output, int capacity)
+{
+  GFace *gf = GModel::current()->getFaceByTag(faceTag);
+  if(!gf) return -1;
+  const auto edges = gf->edges();
+  const auto embedded = gf->getEmbeddedEdges();
+  const auto vertices = gf->getEmbeddedVertices();
+  const int count = (int)(edges.size() + embedded.size() + vertices.size());
+  if(!output || capacity < count) return -2;
+  int row = 0;
+  for(auto edge : edges) {
+    output[3 * row] = 0; output[3 * row + 1] = edge->tag(); output[3 * row + 2] = edge->isSeam(gf); ++row;
+  }
+  for(auto edge : embedded) {
+    output[3 * row] = 1; output[3 * row + 1] = edge->tag(); output[3 * row + 2] = edge->isSeam(gf); ++row;
+  }
+  for(auto vertex : vertices) {
+    if(vertex->mesh_vertices.empty()) return -3;
+    output[3 * row] = 2; output[3 * row + 1] = (double)vertex->mesh_vertices[0]->getNum();
+    output[3 * row + 2] = 0; ++row;
+  }
+  return count;
+}
