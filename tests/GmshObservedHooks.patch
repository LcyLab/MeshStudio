+struct MeshStudioReferenceIntersection {
+  const curveFunctor &curve;
+  const surfaceFunctor &surface;
+};
+bool meshStudioReferenceResidual(fullVector<double> &parameters,
+                                 fullVector<double> &residual, void *context)
+{
+  const auto &data = *static_cast<MeshStudioReferenceIntersection *>(context);
+  const auto s = data.surface(parameters(0), parameters(1));
+  const auto c = data.curve(parameters(2));
+  residual(0) = s.x() - c.x(); residual(1) = s.y() - c.y(); residual(2) = s.z() - c.z();
+  return true;
+}
