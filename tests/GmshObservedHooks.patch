+static std::string meshstudioBdsSnapshot(BDS_Mesh &m,
+  const std::map<BDS_Point *, MVertex *, PointLessThan> &recoverMap,
+  const BDS_GeomEntity *interior = nullptr,const BDS_GeomEntity *exterior = nullptr,const BDS_GeomEntity *boundary = nullptr)
+{
+  std::map<BDS_Edge *, int> edgeIndex;
+  std::map<BDS_Face *, int> faceIndex;
+  for(size_t i = 0; i < m.edges.size(); ++i) edgeIndex[m.edges[i]] = (int)i;
+  for(size_t i = 0; i < m.triangles.size(); ++i) faceIndex[m.triangles[i]] = (int)i;
+  std::ostringstream out; out.imbue(std::locale::classic()); out.precision(17);
+  out << "{\"maximum_id\":" << m.MAXPOINTNUMBER << ",\"points\":[";
+  int row = 0;
+  for(auto p : m.points) {
+    if(row++) out << ',';
+    auto physical = recoverMap.find(p);
+    out << '[' << p->iD << ',' << (physical == recoverMap.end() ? 0 : physical->second->getNum())
+        << ',' << p->u << ',' << p->v << ',' << p->X << ',' << p->Y << ',' << p->Z
+        << ',' << (p->g ? p->g->classif_tag : 0) << ',' << (p->g ? p->g->classif_degree : -1)
+        << ',' << p->lc() << ',' << p->lcBGM() << ',' << int(p->config_modified) << ',' << p->degenerated << ',';
+    if(p->_periodicCounterpart) out << p->_periodicCounterpart->iD; else out << "null";
+    out << ']';
+  }
+  out << "],\"point_edges\":["; row = 0;
+  for(auto p : m.points) {
+    if(row++) out << ','; out << '[';
+    for(size_t i = 0; i < p->edges.size(); ++i) { if(i) out << ','; out << edgeIndex.at(p->edges[i]); }
+    out << ']';
+  }
+  out << "],\"edges\":[";
+  for(size_t i = 0; i < m.edges.size(); ++i) {
+    if(i) out << ','; auto e = m.edges[i];
+    out << '[' << e->p1->iD << ',' << e->p2->iD << ',' << int(e->deleted)
+        << ',' << (e->g ? e->g->classif_tag : 0) << ',' << (e->g ? e->g->classif_degree : -1) << ']';
+  }
+  out << "],\"edge_faces\":[";
+  for(size_t i = 0; i < m.edges.size(); ++i) {
+    if(i) out << ','; out << '['; auto e = m.edges[i];
+    for(int j = 0; j < e->numfaces(); ++j) { if(j) out << ','; out << faceIndex.at(e->faces(j)); }
+    out << ']';
+  }
+  out << "],\"triangles\":[";
+  for(size_t i = 0; i < m.triangles.size(); ++i) {
+    if(i) out << ','; auto f = m.triangles[i];
+    out << '[' << edgeIndex.at(f->e1) << ',' << edgeIndex.at(f->e2) << ',' << edgeIndex.at(f->e3)
+        << ',' << int(f->deleted) << ',' << (f->g ? f->g->classif_tag : 0) << ',' << (f->g ? f->g->classif_degree : -1) << ']';
+  }
+  out << "],\"triangle_nodes\":[";
+  for(size_t i = 0; i < m.triangles.size(); ++i) {
+    if(i) out << ','; BDS_Point *p[4];
+    if(!m.triangles[i]->getNodes(p)) throw std::runtime_error("native BDS nodes unavailable");
+    out << '[' << p[0]->iD << ',' << p[1]->iD << ',' << p[2]->iD << ']';
+  }
+  out << "],\"geometry\":["; row = 0;
+  for(auto g : m.geom) { if(row++) out << ','; out << '[' << g->classif_tag << ',' << g->classif_degree << ']'; }
+  out << ']';
+  if(interior || exterior || boundary) {
+    auto origin = [&](const BDS_GeomEntity *g) { return interior && g == interior ? 1 : exterior && g == exterior ? 2 : boundary && g == boundary ? 3 : 0; };
+    out << ",\"point_geometry_origin\":["; row = 0;
+    for(auto p : m.points) { if(row++) out << ','; out << origin(p->g); }
+    out << "],\"edge_geometry_origin\":[";
+    for(size_t i = 0; i < m.edges.size(); ++i) { if(i) out << ','; out << origin(m.edges[i]->g); }
+    out << "],\"triangle_geometry_origin\":[";
+    for(size_t i = 0; i < m.triangles.size(); ++i) { if(i) out << ','; out << origin(m.triangles[i]->g); } out << ']';
+  }
+  out << '}'; return out.str();
+}
