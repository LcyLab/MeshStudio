+static void meshstudioBdsCleanupMapping(BDS_Mesh &m,
+  const std::vector<BDS_Face *> &oldFaces,const std::vector<BDS_Edge *> &oldEdges,int stage)
+{
+  auto &maps = meshstudioBdsConversionCapture && meshstudioBdsConversionCapture->periodicInterior ?
+    meshstudioBdsConversionCapture->cleanupMappings : meshstudioBdsBoundaryCapture->cleanupMappings;
+  auto fill = [](const auto &oldPool,const auto &newPool,std::vector<int> &mapping) {
+    std::map<const void *,int> previous;
+    for(size_t i = 0; i < oldPool.size(); ++i) previous[oldPool[i]] = (int)i;
+    mapping.assign(oldPool.size(),-1);
+    for(size_t i = 0; i < newPool.size(); ++i) mapping[previous.at(newPool[i])] = (int)i;
+  };
+  fill(oldFaces,m.triangles,maps[2*stage]); fill(oldEdges,m.edges,maps[2*stage+1]);
+}
