+// Fresh BDS context: tests the selection/closure portion independently of prior-loop reuse.
+// Width four: native BDS ID, physical ID, selected u, selected v. -4 means not closed.
+extern "C" MESHSTUDIO_REFERENCE_EXPORT int meshstudioReferencePeriodicLoop(
+  int tag, int loop, double tolerance, int seamFirst, double *output, int capacity)
+{
+  GFace *gf = GModel::current()->getFaceByTag(tag);
+  if(!gf || loop < 0 || loop >= (int)gf->edgeLoops.size() || !output) return -1;
+  auto it = gf->edgeLoops.begin(); std::advance(it, loop);
+  BDS_Mesh mesh; SBoundingBox3d bbox;
+  std::map<BDS_Point *,MVertex *,PointLessThan> recover;
+  std::vector<BDS_Point *> result; int count;
+  if(!buildConsecutiveListOfVertices(gf,*it,result,bbox,&mesh,recover,count,0,tolerance,seamFirst != 0)) return -4;
+  if((int)result.size() > capacity) return -2;
+  for(size_t i = 0; i < result.size(); ++i) {
+    BDS_Point *p = result[i]; double *r = output + 4*i;
+    r[0] = p->iD; r[1] = (double)recover.at(p)->getNum(); r[2] = p->u; r[3] = p->v;
+  }
+  return (int)result.size();
+}
