+    meshstudioBdsBoundaryCapture->embedded ? static_cast<const BDS_GeomEntity *>(domain.exterior) : nullptr);
+  auto requests = [&](const char *name,const std::set<EdgeToRecover> &values) {
+    out << ",\"" << name << "\":["; int row = 0;
+    for(const auto &r : values) { if(row++) out << ','; out << '[' << r.p1 << ',' << r.p2 << ',' << r.ge->tag() << ']'; } out << ']';
+  };
+  requests("registered",registered); requests("not_recovered",failed);
+  const auto &state = meshstudioBdsCurveTrace::state();
+  out << ",\"fatal\":" << (fatal ? "true" : "false") << ",\"needs_refinement\":" << (!fatal && (!failed.empty() || gf->meshStatistics.refineAllEdges) ? "true" : "false")
+      << ",\"failed_curve\":" << (fatal ? state.attempts.back().curve : -1) << ",\"attempts\":[";
+  for(size_t i = 0; i < state.attempts.size(); ++i) {
+    if(i) out << ','; const auto &a = state.attempts[i];
+    out << "{\"curve\":" << a.curve << ",\"index\":" << a.segment << ",\"first\":" << a.first << ",\"second\":" << a.second << ",\"edge\":" << a.edge << ",\"fatal\":" << (a.fatal ? "true" : "false") << ",\"scans\":[";
+    for(size_t j = 0; j < a.scans.size(); ++j) {
+      if(j) out << ','; const auto &s = a.scans[j]; out << "{\"intersected\":[";
+      for(size_t k = 0; k < s.intersected.size(); ++k) { if(k) out << ','; out << s.intersected[k]; }
+      out << "],\"attempts\":[";
+      for(size_t k = 0; k < s.attempts.size(); ++k) { if(k) out << ','; out << '[' << s.attempts[k].first << ',' << (s.attempts[k].second ? "true" : "false") << ']'; } out << "]}";
+    }
+    out << "]}";
+  }
+  out << "],\"skipped\":[";
+  for(size_t i = 0; i < state.skipped.size(); ++i) { if(i) out << ','; out << '[' << state.skipped[i].first << ',' << state.skipped[i].second << ']'; }
+  out << "],\"refine_all\":" << (gf->meshStatistics.refineAllEdges ? "true" : "false") << ",\"boundary_curves\":";
+  meshstudioBdsCurvesJson(out,boundary); out << ",\"embedded_curves\":"; meshstudioBdsCurvesJson(out,embedded); out << '}';
+  meshstudioBdsBoundaryCapture->output = out.str(); meshstudioBdsBoundaryCapture->result = (int)m.triangles.size();
+}
