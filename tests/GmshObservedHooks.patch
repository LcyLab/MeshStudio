+// Explicit oracle calls only: freeze exact pcurves and invoke the native loop helper.
+extern "C" MESHSTUDIO_REFERENCE_EXPORT int meshstudioReferencePeriodicLoopCount(int tag)
+{
+  GFace *gf = GModel::current()->getFaceByTag(tag);
+  return gf ? (int)gf->edgeLoops.size() : -1;
+}
+
+// Width seven: use index, edge tag, seam, physical node, u, v, branch (+1/-1).
+extern "C" MESHSTUDIO_REFERENCE_EXPORT int meshstudioReferencePeriodicLoopInput(
+  int tag, int loop, double *output, int capacity)
+{
+  GFace *gf = GModel::current()->getFaceByTag(tag);
+  if(!gf || loop < 0 || loop >= (int)gf->edgeLoops.size() || !output) return -1;
+  auto it = gf->edgeLoops.begin(); std::advance(it, loop);
+  std::vector<GEdgeSigned> edges(it->begin(), it->end());
+  int row = 0;
+  for(size_t use = 0; use < edges.size(); ++use) {
+    GEdge *ge = edges[use].getEdge();
+    bool seam = ge->isSeam(gf);
+    Range<double> range = ge->parBoundsOnFace(gf);
+    auto append = [&](MVertex *vertex, double t) {
+      for(int branch = 0; branch < (seam ? 2 : 1); ++branch) {
+        if(row >= capacity) return false;
+        int dir = branch ? -1 : 1;
+        SPoint2 uv = ge->reparamOnFace(gf,t,dir);
+        double *r = output + 7 * row++;
+        r[0] = (double)use; r[1] = ge->tag(); r[2] = seam;
+        r[3] = (double)vertex->getNum(); r[4] = uv.x(); r[5] = uv.y(); r[6] = dir;
+      }
+      return true;
+    };
+    if(ge->getBeginVertex()) {
+      if(ge->getBeginVertex()->mesh_vertices.empty()) return -3;
+      if(!append(ge->getBeginVertex()->mesh_vertices[0],range.low())) return -2;
+    }
+    for(auto vertex : ge->mesh_vertices) {
+      double t; vertex->getParameter(0,t);
+      if(!append(vertex,t)) return -2;
+    }
+    if(ge->getEndVertex()) {
+      if(ge->getEndVertex()->mesh_vertices.empty()) return -3;
+      if(!append(ge->getEndVertex()->mesh_vertices[0],range.high())) return -2;
+    }
+  }
+  return row;
+}
