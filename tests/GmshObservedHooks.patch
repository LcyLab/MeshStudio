+  out << "],\"ordered\":["; size_t row = 0;
+  for(auto *t : triangles) { if(row++) out << ','; out << indices.at(t); }
+  out << "],\"rejected_duplicates\":["; row = 0;
+  for(size_t i = 0; i < created.size(); ++i) if(!created[i].inserted) { if(row++) out << ','; out << i; }
+  out << "]}"; return out.str();
