+class MeshStudioReferenceSurface : public surfaceFunctor {
+  double height_, curvature_;
+public:
+  mutable int evaluations = 0;
+  mutable int firstNonfiniteEvaluation = 0;
+  MeshStudioReferenceSurface(double height, double curvature)
+    : height_(height), curvature_(curvature) {}
+  SPoint3 operator()(double u, double v) const override
+  {
+    ++evaluations;
+    const double z = height_ + curvature_ * (u * u + v * v);
+    if(!firstNonfiniteEvaluation && (!std::isfinite(u) || !std::isfinite(v) || !std::isfinite(z)))
+      firstNonfiniteEvaluation = evaluations;
+    return SPoint3(u, v, z);
+  }
