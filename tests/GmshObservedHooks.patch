+namespace meshstudioBdsRecoveryTrace {
+struct Scan {
+    std::vector<int> intersected;
+    std::vector<std::pair<int,bool>> attempts;
+};
+struct State { bool enabled = false; std::vector<Scan> scans; };
+inline State& state() { static State value; return value; }
+inline void start() { state().scans.clear(); state().enabled = true; }
+inline void stop() { state().enabled = false; }
+}
+
+namespace meshstudioBdsCurveTrace {
+struct Attempt {
+    int curve, segment, first, second, edge;
+    bool fatal;
+    std::vector<meshstudioBdsRecoveryTrace::Scan> scans;
+};
+struct State { bool enabled = false; std::vector<Attempt> attempts; std::vector<std::pair<int,int>> skipped; };
+inline State& state() { static State value; return value; }
+inline void start() { state().attempts.clear(); state().skipped.clear(); state().enabled = true; }
+inline void stop() { state().enabled = false; meshstudioBdsRecoveryTrace::stop(); }
+}
+
+namespace meshstudioBdsDomainTrace {
+struct Fill { const void *seed; int tag, degree, origin; std::vector<std::pair<const void *,bool>> visits; };
+struct State { bool enabled = false; const void *interior = nullptr, *exterior = nullptr; std::vector<Fill> fills; std::vector<const void *> cleared; };
+inline State& state() { static State value; return value; }
+inline void reset() { state().enabled = false; state().interior = state().exterior = nullptr; state().fills.clear(); state().cleared.clear(); }
+}
+
+namespace meshstudioBdsMetricTrace {
+struct Attempt {
+  int edge = 0, decision = 1;
+  bool hasConfiguration = false, hasMetric = false;
+  std::array<int,4> configuration{};
+  std::array<double,8> input{}; // UV,du,dv from the actual buildMetric query.
+  std::array<double,3> metric{};
+  std::array<double,5> circle{}; // center,R2,query distance,tolerance.
+};
+struct Scan { size_t startingEdges = 0, endingEdges = 0, swaps = 0; std::vector<Attempt> attempts; };
+struct State { bool enabled = false, captureCircle = false; size_t swaps = 0; std::vector<Scan> scans; std::vector<std::array<int,4>> configurations; };
+inline State& state() { static State value; return value; }
+inline void start() { state() = {}; state().enabled = true; }
+inline void stop() { state().enabled = false; state().captureCircle = false; }
+inline Attempt* current() { auto &s = state(); return s.enabled && !s.scans.empty() && !s.scans.back().attempts.empty() ? &s.scans.back().attempts.back() : nullptr; }
+}
