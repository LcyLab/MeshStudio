+// Test-only boundary stage, including native cross-loop reuse and counterpart assignment.
+// repeats>1 deliberately replays the same CAD loops to exercise prior-loop reuse.
+// points width12: ID,physical,u,v,X,Y,Z,dim,entity,lcBGM,lc,counterpart.
+// loops width5: loop index,position,ID,tolerance,seamFirst. state width8:
+// total positions,MAXPOINTNUMBER,raw bbox min/max UV,model LC,loop count.
+extern "C" MESHSTUDIO_REFERENCE_EXPORT int meshstudioReferencePeriodicBoundaryChart(
+  int tag, int repeats, double *points, int pointCapacity,
+  double *loops, int loopCapacity, double *state)
+{
+  GFace *gf = GModel::current()->getFaceByTag(tag);
+  if(!gf || repeats < 1 || repeats > 3 || !points || !loops || !state) return -1;
+  BDS_Mesh mesh; SBoundingBox3d bbox;
+  std::map<BDS_Point *,MVertex *,PointLessThan> recover;
+  std::map<MVertex *,BDS_Point *> previous;
+  const auto ru = gf->parBounds(0), rv = gf->parBounds(1);
+  const double du = ru.high()-ru.low(), dv = rv.high()-rv.low();
+  const double scale = std::sqrt(du*du+dv*dv);
+  const double factors[] = {1.e-12,1.e-9,1.e-6,1.e-3,1.e-2,1.e-1};
+  int total = 0, loopIndex = 0, loopRow = 0;
