+// Test-only immutable pool snapshot; it does not alter native generation.
+static int meshstudioCopyWalkPools(PolyMesh *pm, double *vertices,
+  double *edges, double *faces, double *state, int capacity)
+{
+  state[0] = (double)pm->vertices.size(); state[1] = (double)pm->hedges.size();
+  state[2] = (double)pm->faces.size();
+  if(capacity < (int)pm->vertices.size() || capacity < (int)pm->hedges.size() ||
+     capacity < (int)pm->faces.size()) return -2;
+  std::unordered_map<PolyMesh::Vertex *, int> vi;
+  std::unordered_map<PolyMesh::HalfEdge *, int> ei;
+  std::unordered_map<PolyMesh::Face *, int> fi;
+  ei[nullptr] = -1;
+  for(size_t i = 0; i < pm->vertices.size(); ++i) vi[pm->vertices[i]] = (int)i;
+  for(size_t i = 0; i < pm->hedges.size(); ++i) ei[pm->hedges[i]] = (int)i;
+  for(size_t i = 0; i < pm->faces.size(); ++i) fi[pm->faces[i]] = (int)i;
+  for(size_t i = 0; i < pm->vertices.size(); ++i) {
+    auto v = pm->vertices[i];
+    vertices[4*i] = i < 4 ? 0 : v->data;
+    vertices[4*i+1] = v->position.x(); vertices[4*i+2] = v->position.y();
+    vertices[4*i+3] = ei.at(v->he);
+  }
+  for(size_t i = 0; i < pm->hedges.size(); ++i) {
+    auto e = pm->hedges[i];
+    const double row[] = {(double)vi.at(e->v), (double)fi.at(e->f),
+      (double)ei.at(e->prev), (double)ei.at(e->next),
+      (double)ei.at(e->opposite), (double)e->data};
+    for(int k = 0; k < 6; ++k) edges[6*i+k] = row[k];
+  }
+  for(size_t i = 0; i < pm->faces.size(); ++i) {
+    faces[2*i] = ei.at(pm->faces[i]->he); faces[2*i+1] = pm->faces[i]->data;
+  }
+  return (int)pm->faces.size();
+}
+extern "C" MESHSTUDIO_REFERENCE_EXPORT int meshstudioReferenceWalkTriangulation(
+  int count, const double *points, const double *bounds, double *vertices,
+  double *edges, double *faces, double *state, int capacity)
+{
+  if(count < 0 || !bounds || !vertices || !edges || !faces || !state || (count && !points)) return -1;
+  if(capacity < 6+6*count) return -2;
+  PolyMesh pm;
+  pm.initialize_rectangle(bounds[0],bounds[2],bounds[1],bounds[3]);
+  PolyMesh::Face *f = pm.faces[0];
+  for(int i = 0; i < count; ++i) {
+    f = Walk(f,points[3*i+1],points[3*i+2]);
+    if(!f) return -3;
+    pm.split_triangle(-1,points[3*i+1],points[3*i+2],0,f,
+      delaunayEdgeCriterionPlaneIsotropic,nullptr);
+    pm.vertices.back()->data = (int)points[3*i];
+  }
+  return meshstudioCopyWalkPools(&pm,vertices,edges,faces,state,capacity);
+}
+extern "C" MESHSTUDIO_REFERENCE_EXPORT int meshstudioReferenceOrdinaryInitialTriangulation(
+  int faceTag, double *vertices, double *edges, double *faces, double *state, int capacity)
+{
+  if(!GModel::current()->getFaceByTag(faceTag) || !vertices || !edges || !faces || !state) return -1;
+  PolyMesh *pm = GFaceInitialMesh(faceTag,0,nullptr);
+  const int result = meshstudioCopyWalkPools(pm,vertices,edges,faces,state,capacity);
+  delete pm;
+  return result;
+}
+
+static int meshstudioCopyRecoveryDecisions(PolyMesh *pm, double *decisions,
+  double *crossings, double *state, int capacity, int crossingCapacity)
+{
+  std::unordered_map<PolyMesh::Vertex *, int> vi;
+  std::unordered_map<PolyMesh::HalfEdge *, int> ei;
+  ei[nullptr] = -1;
+  for(size_t i = 0; i < pm->vertices.size(); ++i) vi[pm->vertices[i]] = (int)i;
+  for(size_t i = 0; i < pm->hedges.size(); ++i) ei[pm->hedges[i]] = (int)i;
+  size_t count = 0;
+  for(const auto &d : meshstudioRecoveryDecisions) count += d.crossed.size();
+  state[3] = (double)meshstudioRecoveryDecisions.size(); state[4] = (double)count;
+  if(capacity < (int)meshstudioRecoveryDecisions.size() || crossingCapacity < (int)count) return -2;
+  size_t offset = 0;
+  for(size_t i = 0; i < meshstudioRecoveryDecisions.size(); ++i) {
+    const auto &d = meshstudioRecoveryDecisions[i];
+    const double row[] = {(double)vi.at(d.from), (double)vi.at(d.to), (double)d.curve,
+      (double)d.result, (double)ei.at(d.edge), (double)offset, (double)d.crossed.size()};
+    for(int k = 0; k < 7; ++k) decisions[7*i+k] = row[k];
+    for(auto edge : d.crossed) crossings[offset++] = ei.at(edge);
+  }
+  return 0;
+}
+extern "C" MESHSTUDIO_REFERENCE_EXPORT int meshstudioReferenceRecoveryIntersection(const double *xy)
+{
+  if(!xy) return -1;
+  PolyMesh::Vertex a(xy[0],xy[1],0), b(xy[2],xy[3],0), c(xy[4],xy[5],0), d(xy[6],xy[7],0);
+  return intersect(&a,&b,&c,&d);
+}
+extern "C" MESHSTUDIO_REFERENCE_EXPORT int meshstudioReferenceConstraintRecovery(
+  int count, const double *points, const double *bounds, int constraintCount,
+  const double *constraints, double *vertices, double *edges, double *faces,
+  double *decisions, double *crossings, double *state, int capacity, int crossingCapacity)
+{
+  if(count < 0 || constraintCount < 0 || !bounds || !vertices || !edges || !faces || !decisions ||
+     !crossings || !state || (count && !points) || (constraintCount && !constraints)) return -1;
+  if(capacity < 6+6*count || capacity < constraintCount) return -2;
+  PolyMesh pm;
+  pm.initialize_rectangle(bounds[0],bounds[2],bounds[1],bounds[3]);
+  PolyMesh::Face *f = pm.faces[0];
+  for(int i = 0; i < count; ++i) {
+    f = Walk(f,points[3*i+1],points[3*i+2]); if(!f) return -3;
+    pm.split_triangle(-1,points[3*i+1],points[3*i+2],0,f,delaunayEdgeCriterionPlaneIsotropic,nullptr);
+    pm.vertices.back()->data = (int)points[3*i];
+  }
+  meshstudioCaptureRecovery = true; meshstudioRecoveryDecisions.clear();
+  for(int i = 0; i < constraintCount; ++i) {
+    int from = (int)constraints[3*i], to = (int)constraints[3*i+1], curve = (int)constraints[3*i+2];
+    if(from < 4 || to < 4 || from >= count+4 || to >= count+4) { meshstudioCaptureRecovery = false; return -4; }
+    auto v0 = pm.vertices[from], v1 = pm.vertices[to]; int r = recover_edge(&pm,v0,v1);
+    auto edge = r >= 0 ? pm.getEdge(v0,v1) : nullptr;
+    if(edge) { edge->data = curve; if(edge->opposite) edge->opposite->data = curve; }
+    meshstudioRecoveryDecisions.push_back({v0,v1,curve,r,edge,meshstudioCapturedCrossings});
+  }
+  meshstudioCaptureRecovery = false;
+  int result = meshstudioCopyWalkPools(&pm,vertices,edges,faces,state,capacity);
+  const int trace = meshstudioCopyRecoveryDecisions(&pm,decisions,crossings,state,capacity,crossingCapacity);
+  meshstudioRecoveryDecisions.clear(); meshstudioCapturedCrossings.clear();
+  return trace < 0 ? trace : result;
+}
+extern "C" MESHSTUDIO_REFERENCE_EXPORT int meshstudioReferenceOrdinaryConstraintRecovery(
+  int faceTag, double *vertices, double *edges, double *faces, double *decisions,
+  double *crossings, double *state, int capacity, int crossingCapacity)
+{
