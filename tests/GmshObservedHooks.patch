+    input << id(n.vertex); out << '[' << id(n.vertex) << ',' << n.values[4] << ',' << n.values[5] << ',' << n.values[2] << ',' << n.values[3] << ']';
+  }
+  out << "],\"indices\":["; size_t row = 0;
+  for(const auto &entry : indices) { if(row++) out << ','; out << '[' << entry.first << ',' << entry.second << ']'; }
+  std::set<std::array<size_t,2>> edges;
+  for(const auto &e : data.internalEdges) { std::array<size_t,2> v{id(e.getVertex(0)),id(e.getVertex(1))}; std::sort(v.begin(),v.end()); edges.insert(v); }
+  out << "],\"internal_edges\":["; row = 0;
+  for(const auto &e : edges) { if(row++) out << ','; out << '[' << e[0] << ',' << e[1] << ']'; }
+  out << "],\"reparameterizations\":["; input << "],\"parameters\":["; row = 0;
+  for(const auto &n : nodes) {
+    if(row++) { out << ','; input << ','; }
+    out << '[' << id(n.vertex) << ',' << n.values[0] << ',' << n.values[1] << ']';
+    input << '[' << id(n.vertex) << ',' << n.values[0] << ',' << n.values[1] << ']';
+  }
+  out << "],\"embedded_queries\":["; row = 0;
+  for(const auto &n : nodes) if(n.embedded) {
+    auto *v = static_cast<const MVertex *>(n.vertex);
+    if(row++) out << ','; out << '[' << id(v) << ",2," << gf->tag() << ',' << n.values[0] << ',' << n.values[1]
+      << ',' << v->x() << ',' << v->y() << ',' << v->z() << ',' << n.values[3] << ']';
+  }
+  out << "]}"; input << "],\"embedded_vertices\":["; row = 0;
+  for(auto *v : gf->getEmbeddedVertices()) if(!v->mesh_vertices.empty()) {
+    if(row++) input << ','; input << '[' << id(v->mesh_vertices.front()) << ',' << v->prescribedMeshSizeAtVertex() << ']';
+  }
+  input << "]}"; return {out.str(),input.str()};
+}
+static std::string meshstudioFrontTrianglesJson(const std::set<MTri3 *,compareTri3Ptr> &triangles)
+{
