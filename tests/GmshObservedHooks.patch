+    out << '[' << ids.at(t->tri()->getVertex(0)) << ',' << ids.at(t->tri()->getVertex(1)) << ',' << ids.at(t->tri()->getVertex(2))
+      << ',' << entry.meshSize << ',' << entry.backgroundSize << ',' << entry.targetSize << ',' << t->getRadius();
+    for(int edge = 0; edge < 3; ++edge) out << ',' << (t->getNeigh(edge) ? indices.at(t->getNeigh(edge)) : -1);
