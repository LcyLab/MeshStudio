+static std::string meshstudioBdsDomainJson(BDS_Mesh &m,
+  const std::map<BDS_Point *,MVertex *,PointLessThan> &recoverMap,const BDS_GeomEntity *boundary = nullptr)
+{
+  const auto &state = meshstudioBdsDomainTrace::state();
+  auto *interior = static_cast<const BDS_GeomEntity *>(state.interior);
+  auto *exterior = static_cast<const BDS_GeomEntity *>(state.exterior);
+  std::map<const void *,int> indices;
+  for(size_t i = 0; i < m.triangles.size(); ++i) indices[m.triangles[i]] = (int)i;
+  std::ostringstream out; out.imbue(std::locale::classic()); out.precision(17);
+  out << "{\"bds\":" << meshstudioBdsSnapshot(m,recoverMap,interior,exterior,boundary) << ",\"fills\":[";
+  for(size_t i = 0; i < state.fills.size(); ++i) {
+    if(i) out << ','; const auto &f = state.fills[i];
+    out << "{\"seed\":" << indices.at(f.seed) << ",\"classification\":[" << f.tag << ',' << f.degree << ',' << f.origin << "],\"visits\":[";
+    for(size_t j = 0; j < f.visits.size(); ++j) { if(j) out << ','; out << '[' << indices.at(f.visits[j].first) << ',' << (f.visits[j].second ? "true" : "false") << ']'; } out << "]}";
+  }
+  out << "],\"cleared_exterior\":[";
+  for(size_t i = 0; i < state.cleared.size(); ++i) { if(i) out << ','; out << indices.at(state.cleared[i]); }
+  size_t inner = 0; for(auto f : m.triangles) if(!f->deleted && f->g == interior) ++inner;
+  out << "],\"interior_triangles\":" << inner << '}';
+  return out.str();
+}
+static void meshstudioCaptureOrdinaryBdsDomain(BDS_Mesh &m,
