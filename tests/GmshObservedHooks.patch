+extern "C" MESHSTUDIO_REFERENCE_EXPORT void meshstudioReferenceSolve3(
+  const double *matrix, const double *rhs, double *result)
+{
+  fullMatrix<double> nativeMatrix(3, 3);
+  fullVector<double> nativeRhs(3), nativeSolution(3);
+  for(int i = 0; i < 3; ++i) {
+    nativeRhs(i) = rhs[i];
+    for(int j = 0; j < 3; ++j) nativeMatrix(i, j) = matrix[3 * i + j];
+  }
+  if(!nativeMatrix.luSolve(nativeRhs, nativeSolution))
+    throw std::runtime_error("native reference linear solve failed");
+  for(int i = 0; i < 3; ++i) result[i] = nativeSolution(i);
+}
+
+extern "C" MESHSTUDIO_REFERENCE_EXPORT int meshstudioReferenceSingularMatrixInverse3(
+  const double *input,double *output)
+{
+  double matrix[3][3],inverse[3][3];
+  fullMatrix<double> native(3,3),right(3,3);
+  fullVector<double> singular(3);
+  for(int i=0;i<3;++i) for(int j=0;j<3;++j) {
+    const double value=input[3*i+j]; if(!std::isfinite(value)) return -1;
+    matrix[i][j]=value; native(i,j)=value;
+  }
+  invert_singular_matrix3x3(matrix,inverse);
+  if(!native.svd(right,singular)) return -2;
+  int count=0;
+  for(int i=0;i<3;++i) for(int j=0;j<3;++j) output[count++]=inverse[i][j];
+  for(int i=0;i<3;++i) for(int j=0;j<3;++j) output[count++]=native(i,j);
+  for(int i=0;i<3;++i) for(int j=0;j<3;++j) output[count++]=right(i,j);
+  int retained=0;
+  for(int i=0;i<3;++i) { output[count++]=singular(i); if(std::abs(singular(i))>1.e-16) ++retained; }
+  output[count++]=retained;
+  return count;
+}
