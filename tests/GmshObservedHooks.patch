+extern "C" MESHSTUDIO_REFERENCE_EXPORT void meshstudioReferenceIntersection(
+  const double *input, double *result)
+{
+  MeshStudioReferenceSurface surface(input[1], input[2]);
+  double parameters[3] = {input[3], input[4], input[5]};
+  bool found = false;
+  if(input[0] == 1.) {
+    curveFunctorCircle circle(SVector3(input[9], input[10], input[11]),
+                              SVector3(input[12], input[13], input[14]),
+                              SVector3(input[6], input[7], input[8]), input[15]);
+    found = intersectCurveSurface(circle, surface, parameters, input[15] * 1.e-8);
+  }
+  else {
+    MeshStudioReferenceParabola curve;
+    MeshStudioReferenceIntersection data{curve, surface};
+    fullVector<double> x(3);
+    for(int i = 0; i < 3; ++i) x(i) = parameters[i];
+    found = newton_fd(meshStudioReferenceResidual, x, &data);
+    if(found) for(int i = 0; i < 3; ++i) parameters[i] = x(i);
+  }
+  result[0] = found;
+  for(int i = 0; i < 3; ++i) result[1 + i] = parameters[i];
+  result[4] = surface.evaluations;
+  result[5] = surface.firstNonfiniteEvaluation;
+}
