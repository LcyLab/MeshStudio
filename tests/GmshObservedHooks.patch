+static void meshstudioCaptureOrdinaryBdsBoundary(BDS_Mesh &m,GFace *gf,
+  const std::map<BDS_Point *,MVertex *,PointLessThan> &recoverMap,
+  const std::vector<GEdge *> &boundary,const std::vector<GEdge *> &embedded,
+  const std::set<EdgeToRecover> &registered,const std::set<EdgeToRecover> &failed,bool fatal)
+{
