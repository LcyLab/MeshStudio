+static void meshstudioBdsCurvesJson(std::ostream &out,const std::vector<GEdge *> &curves)
+{
+  out << '[';
+  for(size_t i = 0; i < curves.size(); ++i) {
+    if(i) out << ','; GEdge *ge = curves[i];
+    out << "{\"entity\":" << ge->tag() << ",\"degenerated\":" << (ge->isMeshDegenerated() ? "true" : "false") << ",\"endpoints\":";
+    if(ge->getBeginVertex()) {
+      if(!ge->getEndVertex() || ge->getBeginVertex()->mesh_vertices.empty() || ge->getEndVertex()->mesh_vertices.empty()) throw std::runtime_error("native curve endpoint mesh unavailable");
+      out << '[' << ge->getBeginVertex()->mesh_vertices[0]->getNum() << ',' << ge->getEndVertex()->mesh_vertices[0]->getNum() << ']';
+    } else out << "null";
+    out << ",\"segments\":[";
+    for(size_t j = 0; j < ge->lines.size(); ++j) { if(j) out << ','; out << '[' << ge->lines[j]->getVertex(0)->getNum() << ',' << ge->lines[j]->getVertex(1)->getNum() << ']'; }
+    out << "]}";
+  }
+  out << ']';
+}
+static bool meshstudioCapturingPeriodicRecovery()
+{ return meshstudioBdsConversionCapture && meshstudioBdsConversionCapture->periodicRecovery; }
+static void meshstudioRecordPeriodicRecoveryAttempt(BDS_Mesh &m,bool embedded,size_t loop,size_t segment,
+  int first,int second,BDS_Edge *edge,bool present,GEdge *curve,bool fatal)
+{
+  if(!meshstudioCapturingPeriodicRecovery()) return;
+  const int index = edge ? (int)(std::find(m.edges.begin(),m.edges.end(),edge)-m.edges.begin()) : -1;
+  std::ostringstream out; out.imbue(std::locale::classic());
+  out << "{\"embedded\":" << (embedded ? "true" : "false") << ",\"loop\":" << loop << ",\"segment\":" << segment
+      << ",\"first\":" << first << ",\"second\":" << second << ",\"edge\":" << index
+      << ",\"already_present\":" << (present ? "true" : "false") << ",\"curve\":";
+  if(curve) out << curve->tag(); else out << "null";
+  out << ",\"recovery\":";
+  if(!embedded && present) out << "null";
+  else {
+    out << "{\"edge\":" << index << ",\"fatal\":" << (fatal ? "true" : "false") << ",\"scans\":[";
+    const auto &scans = meshstudioBdsRecoveryTrace::state().scans;
+    for(size_t i = 0; i < scans.size(); ++i) {
+      if(i) out << ','; out << "{\"intersected\":[";
+      for(size_t j = 0; j < scans[i].intersected.size(); ++j) { if(j) out << ','; out << scans[i].intersected[j]; }
+      out << "],\"attempts\":[";
+      for(size_t j = 0; j < scans[i].attempts.size(); ++j) { if(j) out << ','; out << '[' << scans[i].attempts[j].first << ',' << (scans[i].attempts[j].second ? "true" : "false") << ']'; } out << "]}";
+    }
+    out << "]}";
+  }
+  out << '}'; meshstudioBdsConversionCapture->periodicAttempts.push_back(out.str()); meshstudioBdsRecoveryTrace::stop();
+}
+static void meshstudioCapturePeriodicRecovery(BDS_Mesh &m,GFace *gf,
+  const std::map<BDS_Point *,MVertex *,PointLessThan> &recoverMap,const BDS_GeomEntity *boundary,
+  bool embeddedFailed,bool retry,const std::set<EdgeToRecover> &notRecovered)
+{
+  auto &capture = *meshstudioBdsConversionCapture;
+  std::ostringstream out; out.imbue(std::locale::classic());
+  out << "{\"refine_all\":" << (gf->meshStatistics.refineAllEdges ? "true" : "false") << ",\"boundary_curves\":";
+  meshstudioBdsCurvesJson(out,gf->edges());
+  out << ",\"result\":{\"bds\":" << meshstudioBdsSnapshot(m,recoverMap,nullptr,nullptr,boundary)
+      << ",\"embedded_failed\":" << (embeddedFailed ? "true" : "false") << ",\"needs_retry\":" << (retry ? "true" : "false") << ",\"attempted_boundary_curves\":[";
+  int row = 0; for(const auto &edge : notRecovered) { if(row++) out << ','; out << '[' << edge.p1 << ',' << edge.p2 << ',' << edge.ge->tag() << ']'; }
+  out << "],\"attempts\":[";
+  for(size_t i = 0; i < capture.periodicAttempts.size(); ++i) { if(i) out << ','; out << capture.periodicAttempts[i]; }
+  out << "]}}"; capture.output = out.str(); capture.result = (int)m.triangles.size();
+}
+static std::string meshstudioBdsMetricJson(BDS_Mesh &m,
+  const std::map<BDS_Point *,MVertex *,PointLessThan> &recoverMap,const BDS_GeomEntity *boundary = nullptr)
+{
+  const auto &domain = meshstudioBdsDomainTrace::state(); const auto &state = meshstudioBdsMetricTrace::state();
+  std::ostringstream out; out.imbue(std::locale::classic()); out.precision(17);
+  auto array = [&](const auto &values) { out << '['; for(size_t i = 0; i < values.size(); ++i) { if(i) out << ','; out << values[i]; } out << ']'; };
+  size_t queries = 0; for(const auto &s : state.scans) for(const auto &a : s.attempts) if(a.hasMetric) ++queries;
+  out << "{\"bds\":" << meshstudioBdsSnapshot(m,recoverMap,static_cast<const BDS_GeomEntity *>(domain.interior),static_cast<const BDS_GeomEntity *>(domain.exterior),boundary)
+      << ",\"swaps\":" << state.swaps << ",\"metric_queries\":" << queries << ",\"configurations\":[";
+  for(size_t i = 0; i < state.configurations.size(); ++i) { if(i) out << ','; array(state.configurations[i]); }
+  out << "],\"scans\":[";
+  for(size_t i = 0; i < state.scans.size(); ++i) {
+    if(i) out << ','; const auto &s = state.scans[i];
+    out << "{\"starting_edges\":" << s.startingEdges << ",\"ending_edges\":" << s.endingEdges << ",\"swaps\":" << s.swaps << ",\"attempts\":[";
+    for(size_t j = 0; j < s.attempts.size(); ++j) {
+      if(j) out << ','; const auto &a = s.attempts[j];
+      out << "{\"edge\":" << a.edge << ",\"decision\":" << a.decision << ",\"configuration\":";
+      if(a.hasConfiguration) array(a.configuration); else out << "null";
+      out << ",\"metric_query\":";
+      if(!a.hasMetric) out << "null";
+      else {
+        out << "{\"uv\":[" << a.input[0] << ',' << a.input[1] << "],\"metric\":"; array(a.metric);
+        out << ",\"circle\":"; array(a.circle);
+        out << ",\"inside\":" << ((a.decision == 4 || a.decision == 5) ? "true" : "false") << '}';
+      }
+      out << '}';
+    }
+    out << "]}";
+  }
+  out << "]}"; return out.str();
+}
