# ============================================================
# 行尾与二进制策略
# ------------------------------------------------------------
# 本机 core.autocrlf=true，若不加本文件，git 会对**所有**文件做行尾转换，
# 把 .msp（ZIP 容器）、.pdf 等二进制当成文本处理 → 文件损坏。
# ============================================================

# 默认：由 git 自动判定文本/二进制，文本入库统一 LF
* text=auto

# ---- 二进制：禁止任何转换（几何/文档/归档） ----
*.stl    -text
*.brep   -text
*.stp    -text
*.step   -text
*.iges   -text
*.igs    -text
*.msp    -text
*.vtu    -text
*.msh    -text
*.inp    -text
*.pdf    -text
*.png    -text
*.jpg    -text
*.jpeg   -text
*.gif    -text
*.ico    -text
*.zip    -text
*.7z     -text
*.dll    -text
*.lib    -text
*.exe    -text
*.obj    -text
*.pdb    -text

# ---- 文本：仓库内统一 LF ----
*.c      text eol=lf
*.cc     text eol=lf
*.cpp    text eol=lf
*.cxx    text eol=lf
*.h      text eol=lf
*.hh     text eol=lf
*.hpp    text eol=lf
*.txt    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.qrc    text eol=lf
*.qss    text eol=lf
*.svg    text eol=lf
*.cmake  text eol=lf
CMakeLists.txt text eol=lf
.gitignore     text eol=lf

# ---- Windows 专属文件：保留 CRLF ----
*.bat            text eol=crlf
*.cmd            text eol=crlf
*.ps1            text eol=crlf
*.sln            text eol=crlf
*.vcxproj        text eol=crlf
*.vcxproj.filters text eol=crlf
*.props          text eol=crlf
